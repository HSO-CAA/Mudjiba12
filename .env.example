# ─── S5Y Portfolio — production settings (read by docker-compose.yml) ───
# Copy to .env (same folder as docker-compose.yml) and fill in. Never commit or share the real .env file.
# Everything not listed here has a safe default (see apps/api/.env.example for the full list).

# Database password — a long random string of letters and digits only (no @ : / # ? %),
# because it is placed inside the database URL. Set it once; changing it later needs a database reset.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Your public website address, no trailing slash (used for SEO, sitemap and sharing links)
PUBLIC_URL=https://example.com
# Your domain for automatic HTTPS (docker compose --profile https up -d). Leave empty if you don't use it.
DOMAIN=example.com

# Secret address of the dashboard — pick something hard to guess, e.g. /studio-k39x
# (letters, digits, "-" or "_"; not /api, /media, /work or /assets)
ADMIN_PATH=/studio

# Owner account — created on the FIRST start only (when no account exists yet).
# Changing these later does nothing; to change/reset the password use:
#   docker compose exec app node dist/scripts/create-admin.js --email you@example.com --password 'NewStrongPass'
ADMIN_EMAIL=you@example.com
# REQUIRED (at least 10 characters). The app refuses to start while it is empty.
ADMIN_PASSWORD=
ADMIN_NAME=S5Y

# Keep true when served over HTTPS. Set false only to test over plain http://SERVER-IP:4000
# (with true, the browser drops the login cookie on plain http and you can't sign in).
COOKIE_SECURE=true
# true = trust X-Forwarded-For from the Caddy container / private networks only (safe default).
TRUST_PROXY=true

# Port of the app on the server (http://SERVER-IP:4000). Set APP_BIND=127.0.0.1 once HTTPS works
# so the plain-http port is no longer reachable from the internet.
APP_PORT=4000
APP_BIND=0.0.0.0

# Max video upload size in MB
MAX_VIDEO_MB=2048

# fatal | error | warn | info | debug
LOG_LEVEL=info

# Media storage: empty = automatic (supabase when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, otherwise local).
#   local    = Docker volume "s5y_media" on this server
#   supabase = Supabase Storage (fill the SUPABASE_* lines below)
#   s3       = Cloudflare R2 / AWS S3 / Backblaze / MinIO (fill the S3_* lines below)
STORAGE_DRIVER=

# ── Supabase (optional, see README → Supabase) ──
# Project URL (public), e.g. https://dkfflmtmggjuttdrrgcs.supabase.co — Supabase → Project Settings → Data API
SUPABASE_URL=
# SECRET service_role key (eyJ…) or Secret key (sb_secret_…) — Supabase → Project Settings → API Keys.
# NOT the anon key. Never share it, never commit it, never put it in the website.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket for videos & images (created automatically as a public bucket)
SUPABASE_STORAGE_BUCKET=media
# Use Supabase's database instead of the local "db" container: paste the Session pooler string
# (Supabase → Connect → Session pooler, port 5432) and replace [YOUR-PASSWORD]. Empty = local "db" container.
DATABASE_URL=

# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com  (leave empty for AWS S3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public address of the bucket / CDN, e.g. https://media.example.com (required with STORAGE_DRIVER=s3)
S3_PUBLIC_URL=
# true only for MinIO
S3_FORCE_PATH_STYLE=false
