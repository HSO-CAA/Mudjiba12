# ─── S5Y Portfolio — production settings (used by docker-compose.yml) ───
# Copy to .env and fill in. Never commit the real .env file.

# Database password (any long random string)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Your public website address (used for SEO / sharing links)
PUBLIC_URL=https://example.com
# Your domain for automatic HTTPS (docker compose --profile https up -d)
DOMAIN=example.com

# Secret address of the dashboard — pick something hard to guess, e.g. /studio-k39x
ADMIN_PATH=/studio

# First owner account (created on first start only, if no account exists yet)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=S5Y

# Keep true when served over HTTPS. Set false only to test over plain http://IP:4000
COOKIE_SECURE=true
TRUST_PROXY=true

# Max video upload size in MB
MAX_VIDEO_MB=2048

# Media storage: local (Docker volume) or s3 (Cloudflare R2 / AWS S3 / Backblaze…)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
