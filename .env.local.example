# ─── S5Y — إعدادات Supabase للتشغيل على جهازك (npm run dev / npm start / npm run db:deploy) ───
#
# انسخ هذا الملف باسم .env.local بنفس المجلد (جذر المشروع) وعبّي القيم:
#     cp .env.local.example .env.local
# ملف .env.local مخفي عن git (ما ينرفع على GitHub أبداً). أما هذا الملف (.env.local.example) فينرفع،
# فلا تكتب بيه أي مفتاح أو كلمة سر.
# للسيرفر اللي يشتغل بـ Docker نفس المتغيرات تنكتب بملف .env (شوف .env.example و README).

# ① رابط المشروع (عام، مو سري) — Supabase: Project Settings ← Data API ← Project URL
SUPABASE_URL=https://dkfflmtmggjuttdrrgcs.supabase.co

# ② ⚠️ المفتاح السري service_role — Supabase: Project Settings ← API Keys
#    تبويب «Legacy API Keys» ← service_role ← Reveal (يبدأ بـ eyJ…)، أو Secret key جديد (يبدأ بـ sb_secret_…).
#    مو مفتاح anon! مفتاح anon عام وما يگدر يرفع ملفات.
#    سري جداً: لا تنشره، لا تحطه بكود الموقع، ولا ترفعه على GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# اسم الـ bucket للفيديوهات والصور — السيرفر يسويه تلقائياً (public) إذا ما موجود.
SUPABASE_STORAGE_BUCKET=media

# (اختياري) المفتاح العام anon — السيرفر ما يحتاجه، تگدر تخليه فارغ.
SUPABASE_ANON_KEY=

# ③ ⚠️ رابط قاعدة البيانات — Supabase: زر «Connect» (فوق بالصفحة) ← Session pooler ← انسخ الرابط مثل ما هو،
#    وبدّل [YOUR-PASSWORD] بكلمة سر قاعدة البيانات (اللي اخترتها لمن سويت المشروع؛ تغيّرها من Project Settings ← Database).
#    إذا كلمة السر بيها رموز مثل @ أو # أو / أو ? غيّرها لحروف وأرقام بس.
#    بعدين شيل علامة # من أول السطر. (إذا تخليه معلّق، يستخدم قاعدة البيانات المحلية من apps/api/.env)
# DATABASE_URL=postgresql://postgres.dkfflmtmggjuttdrrgcs:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# نوع التخزين: فارغ = تلقائي (Supabase إذا الرابط والمفتاح السري موجودين، وإلا على هذا الجهاز).
STORAGE_DRIVER=
