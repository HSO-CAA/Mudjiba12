# ───────────────────────────────────────────────────────────────────────────────
# S5Y API — environment variables
# Copy to apps/api/.env (git-ignored) and adjust. Empty values mean "use the default".
# Files are read in this order, without overriding variables that are already set (real environment
# variables always win): apps/api/.env.local → <repo root>/.env.local → apps/api/.env
# Put secrets (Supabase service key, database password) in a .env.local — see /.env.local.example.
# ───────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required).
# Supabase: use the Session pooler string (Supabase → Connect → Session pooler, port 5432), e.g.
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The Transaction pooler (port 6543) can't run migrations (the app adds pgbouncer=true and warns); the direct
# host db.<ref>.supabase.co is IPv6-only on Supabase's Free plan.
DATABASE_URL="postgresql://s5y:CHANGE_ME@localhost:5432/s5y_portfolio?schema=public"

# Only used by `npm test` — a SEPARATE database (the test suite truncates every table).
TEST_DATABASE_URL="postgresql://s5y:CHANGE_ME@localhost:5432/s5y_test?schema=public"

# development | production | test  (default: development — pretty logs; production — JSON logs)
NODE_ENV=development

# Listen address (defaults: 4000 / 0.0.0.0).
PORT=4000
HOST=0.0.0.0

# Canonical public origin, no trailing slash. Used for canonical/OG tags and sitemap.xml.
PUBLIC_URL="http://localhost:4000"

# Secret path of the admin dashboard (default /studio). CHANGE IT in production, e.g. /hq-7f3a9c.
# It is never linked from the public site, robots.txt or sitemap.xml.
ADMIN_PATH="/studio"

# First-run owner account: created only when the database has no users yet.
# Later changes: `npm run create-admin -- --email … --password …` (creates or resets).
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD=""            # at least 10 characters
ADMIN_NAME="S5Y"

# Session cookie `Secure` flag. Defaults to true when NODE_ENV=production.
# Set false ONLY for plain-HTTP testing (e.g. http://localhost).
COOKIE_SECURE=

# Set true behind a reverse proxy (Caddy / Nginx / Railway / Render…) so client IPs (rate limits) come from
# X-Forwarded-For. `true` trusts proxies on loopback, private networks (10/8, 172.16/12, 192.168/16, fc00::/7)
# and 100.64/10 only, so a client hitting the app port directly can't fake its IP. A proxy with a public IP
# (e.g. Cloudflare straight to the app) needs its IPs/CIDRs listed instead (comma-separated) or a hop count (e.g. 1).
TRUST_PROXY=false

# Media storage: local, s3 (S3 / Cloudflare R2 / MinIO) or supabase. Empty = auto-detect: supabase when
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are both set, otherwise local. An explicit value always wins.
STORAGE_DRIVER=
# Local driver root, relative to apps/api (default ./storage). Persist this volume!
# With s3/supabase it is scratch space for uploads/processing, and video originals stay here until they are
# processed (only the processed files are uploaded; served from /media meanwhile).
STORAGE_DIR=./storage

# S3 driver (required when STORAGE_DRIVER=s3: S3_BUCKET and S3_PUBLIC_URL).
S3_ENDPOINT=                 # e.g. https://<account>.r2.cloudflarestorage.com (empty for AWS)
S3_REGION=                   # default "auto" (R2); e.g. eu-central-1 for AWS
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=               # public base URL of the bucket/CDN, e.g. https://media.example.com
S3_FORCE_PATH_STYLE=false    # true for MinIO

# Supabase Storage (STORAGE_DRIVER=supabase or auto-detected). Real values belong in .env.local, never here.
# Media goes to one PUBLIC bucket, created / made public automatically at startup.
SUPABASE_URL=                # project URL, e.g. https://<project-ref>.supabase.co (Project Settings → Data API)
SUPABASE_SERVICE_ROLE_KEY=   # SECRET service_role JWT or sb_secret_… key (Project Settings → API Keys) — not the anon key
SUPABASE_SECRET_KEY=         # alias of SUPABASE_SERVICE_ROLE_KEY (used when that one is empty)
SUPABASE_STORAGE_BUCKET=     # default "media" (lowercase letters, digits, "-", "_", ".")
SUPABASE_ANON_KEY=           # accepted but unused: the server needs the secret key, the site never talks to Supabase

# ffmpeg / ffprobe binaries (auto-detected on PATH). Without them videos are served as uploaded
# (no transcoding, previews or posters) and images are stored in their original format.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Maximum video upload size in MB (default 2048).
MAX_VIDEO_MB=2048

# Production builds served by the API (relative to apps/api). Skipped when missing (dev mode).
WEB_DIST=../web/dist
ADMIN_DIST=../admin/dist

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
